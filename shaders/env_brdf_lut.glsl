// Split-sum environment BRDF LUT lookup (GGX/Smith, Karis 2013).
//
// Table layout: u = NdotV, v = roughness, RG = (A, B) with
//     reflected = A * F0 + B
// generated by brdf/integrator.py (texel centers at (i + 0.5) / res).
// Sample with a linear-filtered, clamp-to-edge sampler.

uniform sampler2D u_EnvBRDFLut;

// Below this roughness the table stores / the shader uses the exact
// mirror limit, so the analytic form is cheaper and singular-free.
const float ENV_BRDF_ROUGHNESS_LIMIT = 1e-3;

// Analytic roughness -> 0 limit: D collapses to a delta at H = N.
vec2 envBRDFMirrorLimit(float NdotV) {
    float fc = pow(1.0 - NdotV, 5.0);
    return vec2(1.0 - fc, fc);
}

// NdotV -> 0 is a removable singularity: the table already contains the
// regularized limit in its first column, so a clamp is all that is needed.
vec2 envBRDF(float roughness, float NdotV) {
    float nv = clamp(NdotV, 0.0, 1.0);
    float r = clamp(roughness, 0.0, 1.0);
    if (r < ENV_BRDF_ROUGHNESS_LIMIT) {
        return envBRDFMirrorLimit(nv);
    }
    return texture(u_EnvBRDFLut, vec2(nv, r)).rg;
}

// Reflected radiance scale for a given F0 (e.g. fresnel reflectance at 0 deg).
vec3 envBRDFApprox(vec3 F0, float roughness, float NdotV) {
    vec2 ab = envBRDF(roughness, NdotV);
    return F0 * ab.x + ab.y;
}
