#version 430 core

layout(local_size_x = 1) in;

layout(std430, binding = 0) readonly buffer CounterBuffer {
    uint visibleCount;
    uint overflow;
};

layout(std430, binding = 1) writeonly buffer IndirectBuffer {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int baseVertex;
    uint baseInstance;
};

uniform uint uVisibleCapacity;

void main() {
    indexCount = min(visibleCount, uVisibleCapacity);
}
