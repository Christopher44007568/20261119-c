#version 430 core

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer InstanceBuffer {
    vec4 spheres[];
};

layout(std430, binding = 1) readonly buffer PlaneBuffer {
    vec4 planes[];
};

layout(std430, binding = 2) writeonly buffer VisibleBuffer {
    uint visibleIds[];
};

layout(std430, binding = 3) buffer CounterBuffer {
    uint visibleCount;
    uint overflow;
};

uniform uint uInstanceCount;
uniform uint uVisibleCapacity;

void main() {
    uint instanceId = gl_GlobalInvocationID.x;
    if (instanceId >= uInstanceCount) {
        return;
    }

    vec4 sphere = spheres[instanceId];
    for (int planeIndex = 0; planeIndex < 6; ++planeIndex) {
        float distance = dot(planes[planeIndex].xyz, sphere.xyz) + planes[planeIndex].w;
        if (distance < -sphere.w - 2.0e-5) {
            return;
        }
    }

    uint slot = atomicAdd(visibleCount, 1u);
    if (slot < uVisibleCapacity) {
        visibleIds[slot] = instanceId;
    } else {
        atomicOr(overflow, 1u);
    }
}
